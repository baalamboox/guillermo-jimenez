white" />
                        <!-- Trazo J -->
                        <path d="M320 127.821C320 140.813 317.215 152.413 311.646 162.622C305.891 172.644 298.001 180.532 287.976 186.286C277.765 191.854 266.162 194.638 253.167 194.638C248.897 194.638 245.462 193.246 242.863 190.462C240.078 187.678 238.686 184.244 238.686 180.161C238.686 175.892 240.078 172.458 242.863 169.86C245.462 167.076 248.897 165.684 253.167 165.684C261.149 165.684 268.204 164.106 274.33 160.951C280.457 157.61 285.284 153.156 288.811 147.588C292.153 141.834 293.824 135.245 293.824 127.821C293.824 120.397 292.153 113.808 288.811 108.055C285.284 102.301 280.457 97.8467 274.33 94.6915C268.204 91.3506 261.149 89.6802 253.167 89.6802L114.209 89.6802C109.939 89.6802 106.504 88.381 103.905 85.7826C101.12 82.9986 99.728 79.565 99.728 75.4817C99.728 71.2129 101.12 67.6865 103.905 64.9025C106.504 62.1184 109.939 60.7264 114.209 60.7264L253.167 60.7264C266.162 60.7264 277.765 63.6032 287.976 69.3569C298.001 75.1105 305.891 82.9986 311.646 93.021C317.215 103.044 320 114.644 320 127.821Z" fill="white" />
                        <!-- Perforación interior de la J -->
                        <path d="M278.055 128.865C278.055 138.475 270.263 146.265 260.65 146.265C251.038 146.265 243.246 138.475 243.246 128.865C243.246 119.255 251.038 111.465 260.65 111.465C270.263 111.465 278.055 119.255 278.055 128.865Z" fill="black" />
                    </mask>
                </defs>

                <!-- Flujo Líquido Multicapa Revelado por la Máscara Monograma -->
                <g mask="url(#gjAppleMonogramMask)">
                    <rect width="320" height="223" fill="url(#gjLiquidGrad1)" />
                    <!-- Blobs de Gradiente Líquido en Movimiento Continuo -->
                    <circle class="gj:lm:liquid-blob gj:lm:liquid-blob-1" cx="80" cy="80" r="140" fill="url(#gjLiquidGrad2)" />
                    <circle class="gj:lm:liquid-blob gj:lm:liquid-blob-2" cx="240" cy="150" r="130" fill="url(#gjLiquidGrad1)" />
                    <circle class="gj:lm:liquid-blob gj:lm:liquid-blob-3" cx="160" cy="110" r="110" fill="var(--gj-lm-grad-accent)" />
                </g>

                <!-- Bisel Esculpido Tipo Cristal Esmerilado en Contornos -->
                <path class="gj:lm:glass-bevel" d="M107.49 223C92.453 223 78.3437 220.216 65.1626 214.648C52.1672 208.894 40.7498 201.006 30.9105 190.984C21.2568 180.776 13.6452 168.897 8.07571 155.348C2.6919 141.799 0 127.137 0 111.361C0 95.7703 2.6919 81.2934 8.07571 67.9301C13.6452 54.3812 21.2568 42.5955 30.9105 32.573C40.7498 22.365 52.1672 14.3841 65.1626 8.63045C78.158 2.87682 92.2673 0 107.49 0C121.785 0 134.038 1.85601 144.249 5.56803C154.645 9.28006 165.042 15.4049 175.438 23.9426C176.923 25.0562 178.037 26.2626 178.78 27.5618C179.708 28.6754 180.265 29.8818 180.45 31.181C180.822 32.2946 181.007 33.6866 181.007 35.357C181.007 38.8835 179.708 41.8531 177.109 44.2659C174.695 46.6787 171.632 47.9779 167.919 48.1635C164.392 48.3491 161.05 47.1427 157.894 44.5443C151.025 38.6051 143.878 34.0578 136.452 30.9026C129.211 27.7474 119.558 26.1698 107.49 26.1698C96.5372 26.1698 86.2337 28.397 76.58 32.8514C66.9263 37.3059 58.3865 43.4307 50.9605 51.226C43.7202 59.0212 38.0579 68.1157 33.9737 78.5094C29.8894 88.7174 27.8473 99.6679 27.8473 111.361C27.8473 123.239 29.8894 134.375 33.9737 144.769C38.0579 154.977 43.7202 163.979 50.9605 171.774C58.3865 179.569 66.9263 185.694 76.58 190.149C86.2337 194.417 96.5372 196.552 107.49 196.552C116.959 196.552 125.87 194.974 134.224 191.819C142.764 188.478 150.932 183.931 158.729 178.177C162.071 175.764 165.32 174.744 168.476 175.115C171.818 175.3 174.602 176.6 176.83 179.012C179.058 181.24 180.172 184.395 180.172 188.478C180.172 190.334 179.801 192.19 179.058 194.046C178.501 195.717 177.387 197.294 175.716 198.779C165.877 206.945 155.202 213.07 143.692 217.154C132.182 221.051 120.115 223 107.49 223ZM180.172 188.478L152.325 182.91V133.076H113.895C109.811 133.076 106.377 131.87 103.592 129.457C100.807 127.044 99.4148 123.982 99.4148 120.27C99.4148 116.558 100.807 113.495 103.592 111.082C106.377 108.67 109.811 107.463 113.895 107.463H165.97C170.24 107.463 173.674 108.855 176.273 111.639C178.872 114.238 180.172 117.671 180.172 121.94V188.478Z" stroke="rgba(255, 255, 255, 0.4)" stroke-width="1.2" fill="none" />
                <path class="gj:lm:glass-bevel" d="M320 127.821C320 140.813 317.215 152.413 311.646 162.622C305.891 172.644 298.001 180.532 287.976 186.286C277.765 191.854 266.162 194.638 253.167 194.638C248.897 194.638 245.462 193.246 242.863 190.462C240.078 187.678 238.686 184.244 238.686 180.161C238.686 175.892 240.078 172.458 242.863 169.86C245.462 167.076 248.897 165.684 253.167 165.684C261.149 165.684 268.204 164.106 274.33 160.951C280.457 157.61 285.284 153.156 288.811 147.588C292.153 141.834 293.824 135.245 293.824 127.821C293.824 120.397 292.153 113.808 288.811 108.055C285.284 102.301 280.457 97.8467 274.33 94.6915C268.204 91.3506 261.149 89.6802 253.167 89.6802L114.209 89.6802C109.939 89.6802 106.504 88.381 103.905 85.7826C101.12 82.9986 99.728 79.565 99.728 75.4817C99.728 71.2129 101.12 67.6865 103.905 64.9025C106.504 62.1184 109.939 60.7264 114.209 60.7264L253.167 60.7264C266.162 60.7264 277.765 63.6032 287.976 69.3569C298.001 75.1105 305.891 82.9986 311.646 93.021C317.215 103.044 320 114.644 320 127.821Z" stroke="rgba(255, 255, 255, 0.4)" stroke-width="1.2" fill="none" />
            </svg>
        </div>

        <!-- Tipografía de Identidad Apple Studio (Pure Helvetica/SF Pro Aesthetic) -->
        <div class="gj:lm:meta-group">
            <h1 class="gj:lm:name">Guillermo Jiménez</h1>
            <p class="gj:lm:subtitle">PRODUCT ARCHITECT // CREATIVE ENGINEER</p>
        </div>

        <!-- Indicador Tipo Dynamic Island Floating Capsule -->
        <div class="gj:lm:dynamic-pill" role="status" aria-live="polite">
            <div class="gj:lm:pill-status">
                <span class="gj:lm:pill-indicator">
                    <span class="gj:lm:pill-dot"></span>
                    <span class="gj:lm:pill-wave"></span>
                </span>
                <span class="gj:lm:pill-text" id="gjLoaderStatus">STUDIO_INIT</span>
                <span class="gj:lm:pill-sep">·</span>
                <span class="gj:lm:pill-pct" id="gjLoaderPct">0%</span>
            </div>
            <!-- Micro Barra de Progreso Líquida -->
            <div class="gj:lm:pill-track">
                <div class="gj:lm:pill-fill" id="gjLoaderBar"></div>
            </div>
        </div>

        <!-- Selector de Modo de Entrada Interactivo (Con Audio // Silencioso) -->
        <div class="gj:lm:actions-group" id="gjLoaderActions">
            <button class="gj:lm:choice-btn gj:lm:choice-sound" id="gjLoaderSoundBtn" type="button" aria-label="Ingresar al portafolio con audio HUD">
                <span class="gj:lm:choice-icon" aria-hidden="true">🔊</span>
                <span class="gj:lm:choice-content">
                    <span class="gj:lm:choice-title">CON AUDIO</span>
                    <span class="gj:lm:choice-sub">EXPERIENCIA COMPLETA</span>
                </span>
            </button>

            <button class="gj:lm:choice-btn gj:lm:choice-mute" id="gjLoaderMuteBtn" type="button" aria-label="Ingresar al portafolio en modo silencioso">
                <span class="gj:lm:choice-icon" aria-hidden="true">🔇</span>
                <span class="gj:lm:choice-content">
                    <span class="gj:lm:choice-title">EN SILENCIO</span>
                    <span class="gj:lm:choice-sub">MODO SILENCIOSO</span>
                </span>
            </button>
        </div>

        <!-- Cyber HUD Audio Hint & Status (Desbloqueo de Autoplay) -->
        <div class="gj:lm:audio-cue" id="gjLoaderAudioCue" role="button" tabindex="0" aria-label="Activar efectos de sonido HUD">
            <span class="gj:lm:audio-cue-wave" aria-hidden="true">
                <span class="gj:lm:audio-bar"></span>
                <span class="gj:lm:audio-bar"></span>
                <span class="gj:lm:audio-bar"></span>
            </span>
            <span class="gj:lm:audio-cue-text" id="gjLoaderAudioCueText">AUDIO HUD DISPONIBLE</span>
        </div>
    </div>
</div>

<!-- Script Autónomo en Línea: Ejecución Inmediata a 60 FPS con Síntesis Cyber Audio Nativa -->
<script is:inline>
    (function () {
        const mask = document.getElementById("gjLoaderMask");
        if (!mask) return;

        // Si el usuario tiene reducción de movimiento activada
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (prefersReducedMotion) {
            mask.style.display = "none";
            document.documentElement.classList.add("gj:content-loaded");
            return;
        }

        // Si ya fue mostrado en esta sesión y no es una recarga explícita, omitir para agilidad de navegación interna
        const navEntries = (performance && typeof performance.getEntriesByType === "function") 
            ? performance.getEntriesByType("navigation") 
            : [];
        const isReload = (navEntries.length > 0 && navEntries[0].type === "reload")
            || (performance && performance.navigation && performance.navigation.type === 1);
        const hasSeen = sessionStorage.getItem("gj_loader_session");

        if (hasSeen && !isReload) {
            mask.style.display = "none";
            document.documentElement.classList.add("gj:content-loaded");
            return;
        }

        sessionStorage.setItem("gj_loader_session", "true");

        // --- MOTOR DE SÍNTESIS ACÚSTICA NATIVO DE LA MÁSCARA ---
        let audioCtx = null;
        let masterGain = null;
        const isSoundEnabled = localStorage.getItem("gj_sound_enabled") !== "false";

        const barEl = document.getElementById("gjLoaderBar");
        const pctEl = document.getElementById("gjLoaderPct");
        const statusEl = document.getElementById("gjLoaderStatus");
        const actionsGroup = document.getElementById("gjLoaderActions");
        const soundBtn = document.getElementById("gjLoaderSoundBtn");
        const muteBtn = document.getElementById("gjLoaderMuteBtn");
        const cueEl = document.getElementById("gjLoaderAudioCue");
        const cueTextEl = document.getElementById("gjLoaderAudioCueText");
        let audioUnlocked = false;

        function markAudioOnline() {
            if (audioUnlocked) return;
            audioUnlocked = true;
            if (cueEl) cueEl.classList.add("gj:lm:audio-active");
            if (cueTextEl) cueTextEl.textContent = "HUD AUDIO ONLINE";
        }

        if (!isSoundEnabled) {
            if (cueEl) cueEl.style.opacity = "0.35";
            if (cueTextEl) cueTextEl.textContent = "AUDIO EN SILENCIO [M]";
        }

        function getAudioContext() {
            if (!isSoundEnabled) return null;
            if (!audioCtx) {
                if (typeof window !== "undefined" && window.__gjSharedAudioCtx) {
                    audioCtx = window.__gjSharedAudioCtx;
                } else {
                    const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtxClass) {
                        audioCtx = new AudioCtxClass();
                        window.__gjSharedAudioCtx = audioCtx;
                    }
                }
                if (audioCtx && !masterGain) {
                    masterGain = audioCtx.createGain();
                    masterGain.gain.setValueAtTime(0.14, audioCtx.currentTime);
                    masterGain.connect(audioCtx.destination);
                }
            }
            return audioCtx;
        }

        // Tics de telemetría HUD en cuartos de carga
        function playTelemetryTick(freq, gainVal) {
            if (!isSoundEnabled) return;
            const ctx = getAudioContext();
            if (!ctx || ctx.state !== "running" || !masterGain) return;
            try {
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(freq || 1800, now);
                gain.gain.setValueAtTime(gainVal || 0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.03);
                osc.connect(gain);
                gain.connect(masterGain);
                osc.start(now);
                osc.stop(now + 0.035);
            } catch (e) {}
        }

        // Desbloqueo y respuesta reactiva instantánea al toque o interacción
        function handleUserUnlock() {
            if (!isSoundEnabled) return;
            const ctx = getAudioContext();
            if (!ctx) return;

            if (ctx.state === "suspended") {
                ctx.resume().then(function () {
                    markAudioOnline();
                    playTelemetryTick(2400, 0.12);
                }).catch(function () {});
            } else if (ctx.state === "running") {
                markAudioOnline();
                playTelemetryTick(2400, 0.12);
            }
        }

        // Intentar autoverificación silenciosa de permisos de autoplay
        const initialCtx = getAudioContext();
        if (initialCtx) {
            if (initialCtx.state === "running") {
                markAudioOnline();
            } else if (initialCtx.state === "suspended") {
                initialCtx.resume().then(function () {
                    if (initialCtx.state === "running") {
                        markAudioOnline();
                    }
                }).catch(function () {});
            }
        }

        // Sonido de confirmación y arranque de reactor
        function playBootSound() {
            if (!isSoundEnabled || window.__gjBootSoundPlayed) return;
            const ctx = getAudioContext();
            if (!ctx || !masterGain) return;

            const executeBoot = function () {
                if (window.__gjBootSoundPlayed || ctx.state !== "running") return;
                window.__gjBootSoundPlayed = true;
                markAudioOnline();
                try {
                    const now = ctx.currentTime;

                    // Tono 1: Reactor Sweep ascendente
                    const osc1 = ctx.createOscillator();
                    const gain1 = ctx.createGain();
                    osc1.type = "sine";
                    osc1.frequency.setValueAtTime(160, now);
                    osc1.frequency.exponentialRampToValueAtTime(780, now + 0.32);
                    gain1.gain.setValueAtTime(0.001, now);
                    gain1.gain.linearRampToValueAtTime(0.22, now + 0.08);
                    gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
                    osc1.connect(gain1);
                    gain1.connect(masterGain);
                    osc1.start(now);
                    osc1.stop(now + 0.46);

                    // Tono 2: Shimmer armónico holográfico
                    const osc2 = ctx.createOscillator();
                    const gain2 = ctx.createGain();
                    osc2.type = "triangle";
                    osc2.frequency.setValueAtTime(1320, now + 0.16);
                    osc2.frequency.exponentialRampToValueAtTime(1760, now + 0.38);
                    gain2.gain.setValueAtTime(0.001, now + 0.16);
                    gain2.gain.linearRampToValueAtTime(0.12, now + 0.22);
                    gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.52);
                    osc2.connect(gain2);
                    gain2.connect(masterGain);
                    osc2.start(now + 0.16);
                    osc2.stop(now + 0.53);
                } catch (e) {}
            };

            if (ctx.state === "running") {
                executeBoot();
            } else if (ctx.state === "suspended") {
                ctx.resume().then(function () {
                    executeBoot();
                }).catch(function () {});
            }
        }

        let isDone = false;
        let isExiting = false;
        let autoExitTimeout = null;
        const startTime = performance.now();
        const duration = 1100; // Duración fluida de 1.1 segundos
        let played25 = false;
        let played50 = false;
        let played75 = false;

        const enterExperience = function (enableAudio) {
            if (isExiting) return;
            isExiting = true;

            if (autoExitTimeout) {
                clearTimeout(autoExitTimeout);
                autoExitTimeout = null;
            }

            if (barEl) barEl.style.width = "100%";
            if (pctEl) pctEl.textContent = "100%";
            if (statusEl) statusEl.textContent = "STUDIO_READY";

            if (enableAudio) {
                try {
                    localStorage.setItem("gj_sound_enabled", "true");
                } catch (e) {}
                const engine = window.__gjAudioEngine || window.cyberAudio;
                if (engine) {
                    engine.setSound(true);
                }
                const ctx = getAudioContext();
                if (ctx) {
                    if (ctx.state === "suspended") {
                        ctx.resume().then(function () {
                            playBootSound();
                        }).catch(function () {
                            playBootSound();
                        });
                    } else {
                        playBootSound();
                    }
                } else {
                    playBootSound();
                }
                markAudioOnline();
            } else {
                try {
                    localStorage.setItem("gj_sound_enabled", "false");
                } catch (e) {}
                const engine = window.__gjAudioEngine || window.cyberAudio;
                if (engine) {
                    engine.setSound(false);
                }
                window.__gjBootSoundPlayed = true;
            }

            mask.classList.add("gj:lm:complete");

            setTimeout(function () {
                mask.classList.add("gj:lm:exit");
                document.documentElement.classList.add("gj:content-loaded");

                setTimeout(function () {
                    mask.classList.add("gj:lm:remove");
                    mask.style.display = "none";
                }, 520);
            }, 260);
        };

        const onProgressComplete = function () {
            if (isDone) return;
            isDone = true;

            if (barEl) barEl.style.width = "100%";
            if (pctEl) pctEl.textContent = "100%";
            if (statusEl) statusEl.textContent = "STUDIO_READY";

            mask.classList.add("gj:lm:ready-to-enter");
            if (actionsGroup) actionsGroup.classList.add("gj:lm:actions-ready");
            if (cueTextEl) cueTextEl.textContent = "SELECCIONA CÓMO DESEAS INGRESAR";

            // Auto-avance de cortesía tras 5 segundos si no hay interacción
            autoExitTimeout = setTimeout(function () {
                const shouldSound = localStorage.getItem("gj_sound_enabled") !== "false";
                enterExperience(shouldSound);
            }, 5000);
        };

        // Eventos de selección directa por botón
        if (soundBtn) {
            soundBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                enterExperience(true);
            });
        }

        if (muteBtn) {
            muteBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                enterExperience(false);
            });
        }

        // Si el usuario toca la pantalla durante la carga para acelerar
        mask.addEventListener("click", function (e) {
            if (isDone) {
                // Si ya completó y hace clic fuera de los botones, entrar con audio
                if (!e.target.closest("#gjLoaderMuteBtn")) {
                    enterExperience(true);
                }
            } else {
                // Si aún está cargando y hace clic, acelerar e ingresar con audio
                enterExperience(true);
            }
        });

        mask.addEventListener("pointerdown", function () {
            const ctx = getAudioContext();
            if (ctx && ctx.state === "suspended") {
                ctx.resume().catch(function () {});
            }
        }, { passive: true });

        window.addEventListener("keydown", function (e) {
            if (isExiting) return;
            if (e.key === "Enter" || e.key === " " || e.key === "1") {
                enterExperience(true);
            } else if (e.key === "m" || e.key === "M" || e.key === "0" || e.key === "Escape") {
                enterExperience(false);
            }
        });

        const tick = function (now) {
            if (isDone || isExiting) return;
            const elapsed = now - startTime;
            const factor = Math.min(elapsed / duration, 1);

            // Easing cúbico fluido estilo Apple (easeOutCubic)
            const ease = 1 - Math.pow(1 - factor, 3);
            const progress = Math.round(ease * 100);

            // Micro-pulsos de telemetría cuántica en cuartos de carga
            if (progress >= 25 && !played25) {
                played25 = true;
                playTelemetryTick(1400, 0.05);
            }
            if (progress >= 50 && !played50) {
                played50 = true;
                playTelemetryTick(1700, 0.06);
            }
            if (progress >= 75 && !played75) {
                played75 = true;
                playTelemetryTick(2100, 0.07);
            }

            if (barEl) barEl.style.width = progress + "%";
            if (pctEl) pctEl.textContent = progress + "%";

            if (factor < 1) {
                requestAnimationFrame(tick);
            } else {
                onProgressComplete();
            }
        };

        requestAnimationFrame(tick);

        // Temporizador de seguridad de carga máxima (1.5s) para mostrar los botones
        setTimeout(onProgressComplete, 1500);
    })();
</script>