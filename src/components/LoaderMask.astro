---
import "../css/loader-mask.css";
---

<div class="gj:lm:wrapper" id="gjLoaderMask" aria-hidden="true" transition:persist>
    <!-- Atmósfera Líquida y Destellos Aurora Multidimensionales -->
    <div class="gj:lm:ambient-aurora" aria-hidden="true">
        <div class="gj:lm:aurora-sphere gj:lm:aurora-1"></div>
        <div class="gj:lm:aurora-sphere gj:lm:aurora-2"></div>
        <div class="gj:lm:aurora-sphere gj:lm:aurora-3"></div>
    </div>

    <!-- Escenario Central: Apple Studio Glass Card & Monograma Líquido -->
    <div class="gj:lm:stage" id="gjLoaderStage">
        <!-- Tarjeta Flotante Esculpida en Cristal Líquido -->
        <div class="gj:lm:brand-card">
            <div class="gj:lm:card-lens-flare" aria-hidden="true"></div>

            <!-- Monograma GJ con Liquid Mesh Gradient dinámico en SVG -->
            <svg class="gj:lm:apple-logo" viewBox="0 0 320 223" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <!-- Gradientes Líquidos Cinemáticos -->
                    <linearGradient id="gjLiquidGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="var(--gj-lm-grad-1)" />
                        <stop offset="50%" stop-color="var(--gj-lm-grad-2)" />
                        <stop offset="100%" stop-color="var(--gj-lm-grad-3)" />
                    </linearGradient>
                    <linearGradient id="gjLiquidGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="var(--gj-lm-grad-4)" />
                        <stop offset="50%" stop-color="var(--gj-lm-grad-2)" />
                        <stop offset="100%" stop-color="var(--gj-lm-grad-1)" />
                    </linearGradient>

                    <!-- Máscara Vectorial de Precisión Monograma GJ -->
                    <mask id="gjAppleMonogramMask" maskUnits="userSpaceOnUse" x="0" y="0" width="320" height="223">
                        <rect width="320" height="223" fill="black" />
                        <!-- Trazo G -->
