---
import Layout from "../layouts/Layout.astro";
import "../css/experience.css";
import data from "../data/data.js";
const experiences = data.experience || [];
---

<Layout title="Experiencia">
    <div class="gj:layout:container">
        <div class="gj:experience:container">
            <!-- Encabezado de la Sección -->
            <header class="gj:experience:header">
                <h1 class="gj:experience:title">Trayectoria Profesional</h1>
                <p class="gj:experience:subtitle">
                    Mi recorrido técnico desarrollando software escalable, interfaces reactivas y soluciones web en diversas industrias.
                </p>
            </header>

            <!-- Línea de Tiempo Interactiva -->
            <ul class="gj:experience:list" role="list">
                {experiences.map((item, index) => (
                    <li 
                        class={`gj:experience:list-item ${index === 0 ? "gj:experience:list-item:active" : ""}`}
                        data-id-experience={item.id}
                        data-index={index}
                        style={`--brand-color: ${item.brand_color};`}
                        role="button"
                        tabindex="0"
                        aria-expanded={index === 0 ? "true" : "false"}
                        aria-label={`Experiencia en ${item.company} como ${item.role}`}
                    >
                        <!-- Nodo de la Línea de Tiempo -->
                        <div class="gj:experience:node" aria-hidden="true">
                            <span class="gj:experience:node-dot"></span>
                            <span class="gj:experience:node-pulse"></span>
                        </div>

                        <!-- Tarjeta Principal -->
                        <div class="gj:experience:card">
                            <!-- Cabecera de la Tarjeta -->
                            <div class="gj:experience:card-header">
                                <div class="gj:experience:left">
                                    <div class="gj:experience:business-name-wrapper">
                                        <span class="gj:experience:business-name-underline"></span>
                                        <h2 class="gj:experience:business-name">{item.company}</h2>
                                    </div>
                                    <p class="gj:experience:position">{item.role}</p>
                                </div>

                                <div class="gj:experience:right">
                                    <div class="gj:experience:badges">
                                        <span class="gj:experience:badge gj:experience:badge-modality">
                                            {item.modality}
                                        </span>
                                        <span class="gj:experience:badge gj:experience:badge-date">
                                            ⏱ {item.period}
                                        </span>
                                    </div>

                                    <div class="gj:experience:location">
                                        <span class="gj:layout:svg-wrapper">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                                                <path fill="currentColor" d="M18.364 17.364L12 23.728l-6.364-6.364a9 9 0 1 1 12.728 0M12 13a2 2 0 1 0 0-4a2 2 0 0 0 0 4" />
                                            </svg>
                                        </span>
                                        <span>{item.location}</span>
                                    </div>
                                </div>

                                <!-- Botón de Enlace al Sitio Web -->
                                {item.website && (
                                    <a 
                                        class="gj:experience:list-item:link" 
                                        href={item.website} 
                                        target="_blank" 
                                        rel="noopener noreferrer" 
                                        aria-label={`Visitar sitio oficial de ${item.company}`}
                                        onclick="event.stopPropagation();"
                                    >
                                        <span class="gj:layout:svg-wrapper">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
                                                <path fill="currentColor" d="M14 3v2h3.59l-9.83 9.83l1.41 1.41L19 6.41V10h2V3m-2 16H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7Z"/>
                                            </svg>
                                        </span>
                                    </a>
                                )}
                            </div>

                            <!-- Contenido Expansible (Logros y Tecnologías) -->
                            <div class="gj:experience:details">
                                <p class="gj:experience:summary">{item.summary}</p>

                                {item.achievements && item.achievements.length > 0 && (
                                    <div class="gj:experience:achievements-wrapper">
                                        <p class="gj:experience:achievements-title">Logros y Responsabilidades Clave:</p>
                                        <ul class="gj:experience:achievements-list">
                                            {item.achievements.map((ach) => (
                                                <li class="gj:experience:achievement-item">
                                                    <span class="gj:experience:achievement-bullet" aria-hidden="true">▸</span>
                                                    <span>{ach}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}

                                {item.technologies && item.technologies.length > 0 && (
                                    <div class="gj:experience:techs-wrapper">
                                        <p class="gj:experience:techs-title">Stack Implementado:</p>
                                        <div class="gj:experience:tech-grid">
                                            {item.technologies.map((tech) => (
                                                <span class="gj:experience:tech-pill">
                                                    <span class="gj:experience:tech-dot"></span>
                                                    <span>{tech}</span>
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</Layout>

<script src="../js/experience.js"></script>
